{
  "manifest_version": 3,
  "name": "Nuvio for Google Search",
  "version": "1.0.0",
  "description": "Adds Nuvio to the watch movie/series provider options in Google Search with desktop app launching and web fallback.",
  "author": "Nuvio Community",
  "homepage_url": "https://nuvio-web.vercel.app/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Nuvio for Google Search"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://*.google.ad/*",
    "*://*.google.ae/*",
    "*://*.google.com.au/*",
    "*://*.google.co.uk/*",
    "*://*.google.ca/*",
    "*://*.google.de/*",
    "*://*.google.es/*",
    "*://*.google.fr/*",
    "*://*.google.it/*",
    "*://*.google.co.in/*",
    "*://*.google.co.jp/*",
    "*://*.google.com.br/*",
    "*://nuvio-web.vercel.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/search*",
        "*://*.google.ad/search*",
        "*://*.google.ae/search*",
        "*://*.google.com.au/search*",
        "*://*.google.co.uk/search*",
        "*://*.google.ca/search*",
        "*://*.google.de/search*",
        "*://*.google.es/search*",
        "*://*.google.fr/search*",
        "*://*.google.it/search*",
        "*://*.google.co.in/search*",
        "*://*.google.co.jp/search*",
        "*://*.google.com.br/search*",
        "*://*.google.com.*/search*",
        "*://*.google.co.*/search*"
      ],
      "js": [
        "utils/browser-polyfill.js",
        "utils/storage.js",
        "utils/modal.js",
        "utils/protocol-launcher.js",
        "content/google.js"
      ],
      "css": [
        "content/google.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://nuvio-web.vercel.app/*"
      ],
      "js": [
        "utils/browser-polyfill.js",
        "content/nuvio-web.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png",
        "icons/*.svg"
      ],
      "matches": [
        "*://*.google.com/*",
        "*://*.google.ad/*",
        "*://*.google.ae/*",
        "*://*.google.com.au/*",
        "*://*.google.co.uk/*",
        "*://*.google.ca/*",
        "*://*.google.de/*",
        "*://*.google.es/*",
        "*://*.google.fr/*",
        "*://*.google.it/*",
        "*://*.google.co.in/*",
        "*://*.google.co.jp/*",
        "*://*.google.com.br/*",
        "*://*.google.com.*/*",
        "*://*.google.co.*/*",
        "https://nuvio-web.vercel.app/*"
      ]
    }
  ]
}
